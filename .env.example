# ==========================================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.
# ==========================================================

# ---- Server ----
SERVER_PORT=8080
# Set to 1 when the app is served over HTTPS (adds Secure flag to cookies).
COOKIE_SECURE=0

# ---- Database ----
# Option A (recommended): a single connection string.
DATABASE_URL=postgres://family:family@localhost:5432/family?sslmode=disable
# Option B: components (used only when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_USER=family
DB_PASSWORD=family
DB_NAME=family
DB_SSLMODE=disable

# ---- Security ----
# REQUIRED. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Optional first admin (created on startup if no admin exists yet) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Used by docker-compose for the postgres service ----
POSTGRES_USER=family
POSTGRES_PASSWORD=family
POSTGRES_DB=family
